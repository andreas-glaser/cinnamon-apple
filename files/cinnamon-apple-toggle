#!/usr/bin/python3 -I
"""Switch between the Mac keyboard from cinnamon-apple and stock Cinnamon.

Usage: cinnamon-apple-toggle [on|off]

Without an argument the current mode flips. Off saves the shortcuts
cinnamon-apple sets, resets them to Cinnamon's defaults and stops Toshy; on
restores them and starts Toshy again.
"""
import json
import os
import subprocess
import sys
import tempfile

from gi.repository import Gio

KEYS = "org.cinnamon.desktop.keybindings"
SHORTCUTS = {
    f"{KEYS}.wm": [
        "activate-window-menu",
        "close",
        "minimize",
        "move-to-center",
        "push-tile-down",
        "push-tile-left",
        "push-tile-right",
        "push-tile-up",
        "toggle-fullscreen",
        "toggle-maximized",
        "unmaximize",
    ],
    f"{KEYS}.media-keys": ["screensaver"],
}
CUSTOM_PREFIX = "custom-cinnamon-apple-"
TOGGLE_ID = CUSTOM_PREFIX + "toggle"
TOSHY = "toshy-config.service"

STATE_HOME = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
# Present only while the Mac keyboard is off.
SAVED = os.path.join(STATE_HOME, "cinnamon-apple", "mac-keyboard.json")


def toshy(action):
    installed = subprocess.run(
        ["systemctl", "--user", "cat", TOSHY], capture_output=True, timeout=30
    ).returncode == 0
    if installed:
        subprocess.run(["systemctl", "--user", action, TOSHY], check=True, timeout=30)


def notify(text):
    subprocess.run(
        ["notify-send", "--app-name=cinnamon-apple", "--icon=input-keyboard", text],
        check=True, timeout=10,
    )


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp_path = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".mac-keyboard.")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=4)
        os.replace(tmp_path, path)
    except BaseException:
        os.unlink(tmp_path)
        raise


def turn_off():
    if os.path.exists(SAVED):
        toshy("stop")
        return
    keybindings = Gio.Settings.new(KEYS)
    custom_list = keybindings.get_strv("custom-list")
    saved = {
        "shortcuts": {
            schema: {key: Gio.Settings.new(schema).get_strv(key) for key in keys}
            for schema, keys in SHORTCUTS.items()
        },
        "custom": [
            name for name in custom_list if name.startswith(CUSTOM_PREFIX) and name != TOGGLE_ID
        ],
    }
    # Saved before anything changes, so an interrupted run can still be undone.
    write_json(SAVED, saved)

    for schema, keys in SHORTCUTS.items():
        settings = Gio.Settings.new(schema)
        for key in keys:
            settings.reset(key)
    keybindings.set_strv("custom-list", [name for name in custom_list if name not in saved["custom"]])
    Gio.Settings.sync()
    toshy("stop")
    notify("Mac keyboard off")


def turn_on():
    if not os.path.exists(SAVED):
        toshy("start")
        return
    with open(SAVED) as f:
        saved = json.load(f)

    for schema, values in saved["shortcuts"].items():
        settings = Gio.Settings.new(schema)
        for key, value in values.items():
            settings.set_strv(key, value)
    keybindings = Gio.Settings.new(KEYS)
    custom_list = keybindings.get_strv("custom-list")
    keybindings.set_strv(
        "custom-list", custom_list + [name for name in saved["custom"] if name not in custom_list]
    )
    Gio.Settings.sync()
    toshy("start")
    os.remove(SAVED)
    notify("Mac keyboard on")


def main(args):
    if args == []:
        mode = "on" if os.path.exists(SAVED) else "off"
    elif args in (["on"], ["off"]):
        mode = args[0]
    else:
        sys.exit(__doc__.splitlines()[2])
    if mode == "on":
        turn_on()
    else:
        turn_off()


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except Exception as err:
        # Usually run from a shortcut, where nobody sees stderr.
        notify(f"Mac keyboard toggle failed: {err}")
        raise
